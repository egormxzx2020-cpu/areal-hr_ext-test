        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ORGANIZATIONS ||--o{ DEPARTMENTS : \&quot;содержит отделы\&quot;\n    DEPARTMENTS ||--o{ DEPARTMENTS : \&quot;родительский отдел (вложенность)\&quot;\n    \n    ORGANIZATIONS ||--o{ AUDIT_LOGS : \&quot;аудит\&quot;\n    DEPARTMENTS ||--o{ AUDIT_LOGS : \&quot;аудит\&quot;\n    POSITIONS ||--o{ AUDIT_LOGS : \&quot;аудит\&quot;\n    EMPLOYEES ||--o{ AUDIT_LOGS : \&quot;аудит\&quot;\n    PERSONNEL_ACTIONS ||--o{ AUDIT_LOGS : \&quot;аудит\&quot;\n\n    EMPLOYEES ||--o{ EMPLOYEE_PASSPORT_FILES : \&quot;сканы паспорта\&quot;\n    FILES ||--o{ EMPLOYEE_PASSPORT_FILES : \&quot;файл скана\&quot;\n\n    EMPLOYEES ||--o{ PERSONNEL_ACTIONS : \&quot;кадровые события\&quot;\n    DEPARTMENTS ||--o{ PERSONNEL_ACTIONS : \&quot;отдел назначения\&quot;\n    POSITIONS ||--o{ PERSONNEL_ACTIONS : \&quot;должность назначения\&quot;\n\n    USERS ||--o{ AUDIT_LOGS : \&quot;автор изменений\&quot;\n\n    ORGANIZATIONS[\&quot;(Организации)&lt;br/&gt;ORGANIZATIONS\&quot;] {\n        uuid id PK\n        varchar name\n        text comment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    DEPARTMENTS[\&quot;(Отделы)&lt;br/&gt;DEPARTMENTS\&quot;] {\n        uuid id PK\n        uuid organization_id FK\n        uuid parent_id FK\n        varchar name\n        text comment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    POSITIONS[\&quot;(Должности)&lt;br/&gt;POSITIONS\&quot;] {\n        uuid id PK\n        varchar name\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    EMPLOYEES[\&quot;(Сотрудники)&lt;br/&gt;EMPLOYEES\&quot;] {\n        uuid id PK\n        varchar last_name\n        varchar first_name\n        varchar middle_name\n        date birth_date\n        varchar passport_series\n        varchar passport_number\n        date passport_issue_date\n        varchar passport_department_code\n        varchar passport_issued_by\n        varchar reg_region\n        varchar reg_city\n        varchar reg_street\n        varchar reg_house\n        varchar reg_building\n        varchar reg_apartment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    FILES[\&quot;(Файлы)&lt;br/&gt;FILES\&quot;] {\n        uuid id PK\n        varchar name\n        varchar file_path\n        varchar mime_type\n        int size\n        timestamptz created_at\n    }\n\n    EMPLOYEE_PASSPORT_FILES[\&quot;(Сканы паспортов)&lt;br/&gt;EMPLOYEE_PASSPORT_FILES\&quot;] {\n        uuid employee_id FK\n        uuid file_id FK\n    }\n\n    PERSONNEL_ACTIONS[\&quot;(Кадровые операции)&lt;br/&gt;PERSONNEL_ACTIONS\&quot;] {\n        uuid id PK\n        uuid employee_id FK\n        varchar action_type\n        uuid department_id FK\n        uuid position_id FK\n        numeric salary\n        date action_date\n        timestamptz created_at\n    }\n\n    USERS[\&quot;(Пользователи)&lt;br/&gt;USERS\&quot;] {\n        uuid id PK\n        varchar last_name\n        varchar first_name\n        varchar middle_name\n        varchar login UK\n        varchar password_hash\n        varchar role\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    AUDIT_LOGS[\&quot;(История изменений)&lt;br/&gt;AUDIT_LOGS\&quot;] {\n        uuid id PK\n        timestamptz changed_at\n        uuid user_id FK\n        varchar entity_type\n        varchar entity_id\n        jsonb changed_fields\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="C7i8pSAOkXRXDFmo12vy-1">
