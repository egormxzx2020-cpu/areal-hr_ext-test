  <diagram name="Страница-1" id="53QDv1gPOr3pYH7qqU1I">
    <mxGraphModel dx="2581" dy="1375" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ORGANIZATIONS ||--o{ DEPARTMENTS : \&quot;содержит отделы\&quot;\n    DEPARTMENTS ||--o{ DEPARTMENTS : \&quot;родительский отдел (вложенность)\&quot;\n\n    EMPLOYEES ||--o{ EMPLOYEE_PASSPORT_FILES : \&quot;сканы паспорта\&quot;\n    FILES ||--o{ EMPLOYEE_PASSPORT_FILES : \&quot;файл скана\&quot;\n\n    EMPLOYEES ||--o{ PERSONNEL_ACTIONS : \&quot;кадровые события\&quot;\n    DEPARTMENTS ||--o{ PERSONNEL_ACTIONS : \&quot;отдел назначения\&quot;\n    POSITIONS ||--o{ PERSONNEL_ACTIONS : \&quot;должность назначения\&quot;\n\n    USERS ||--o{ AUDIT_LOGS : \&quot;автор изменений (user_id FK)\&quot;\n\n    ORGANIZATIONS[\&quot;(Организации)&lt;br/&gt;ORGANIZATIONS\&quot;] {\n        uuid id PK\n        varchar name \&quot;UNIQUE (WHERE deleted_at IS NULL)\&quot;\n        text comment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    DEPARTMENTS[\&quot;(Отделы)&lt;br/&gt;DEPARTMENTS\&quot;] {\n        uuid id PK\n        uuid organization_id FK \&quot;INDEX\&quot;\n        uuid parent_id FK \&quot;INDEX\&quot;\n        varchar name \&quot;UNIQUE(org_id, parent_id, name) WHERE deleted_at IS NULL\&quot;\n        text comment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    POSITIONS[\&quot;(Должности)&lt;br/&gt;POSITIONS\&quot;] {\n        uuid id PK\n        varchar name \&quot;UNIQUE (WHERE deleted_at IS NULL)\&quot;\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    EMPLOYEES[\&quot;(Сотрудники)&lt;br/&gt;EMPLOYEES\&quot;] {\n        uuid id PK\n        varchar last_name\n        varchar first_name\n        varchar middle_name\n        date birth_date\n        varchar_4 passport_series \&quot;varchar(4)\&quot;\n        varchar_6 passport_number \&quot;varchar(6)\&quot;\n        date passport_issue_date\n        varchar_7 passport_department_code \&quot;varchar(7)\&quot;\n        varchar passport_issued_by\n        varchar reg_region\n        varchar reg_city\n        varchar reg_street\n        varchar reg_house\n        varchar reg_building\n        varchar reg_apartment\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    FILES[\&quot;(Файлы)&lt;br/&gt;FILES\&quot;] {\n        uuid id PK\n        varchar name\n        varchar file_path\n        varchar mime_type\n        int size\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    EMPLOYEE_PASSPORT_FILES[\&quot;(Сканы паспортов)&lt;br/&gt;EMPLOYEE_PASSPORT_FILES\&quot;] {\n        uuid employee_id PK_FK\n        uuid file_id PK_FK\n    }\n\n    PERSONNEL_ACTIONS[\&quot;(Кадровые операции)&lt;br/&gt;PERSONNEL_ACTIONS\&quot;] {\n        uuid id PK\n        uuid employee_id FK \&quot;INDEX\&quot;\n        varchar action_type \&quot;CHECK: hire, transfer_dept, change_salary, fire\&quot;\n        uuid department_id FK\n        uuid position_id FK\n        numeric salary\n        date action_date\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    USERS[\&quot;(Пользователи)&lt;br/&gt;USERS\&quot;] {\n        uuid id PK\n        varchar last_name\n        varchar first_name\n        varchar middle_name\n        varchar login \&quot;UNIQUE (WHERE deleted_at IS NULL)\&quot;\n        varchar password_hash\n        varchar role \&quot;CHECK: admin, hr_manager\&quot;\n        timestamptz created_at\n        timestamptz updated_at\n        timestamptz deleted_at\n    }\n\n    AUDIT_LOGS[\&quot;(История изменений)&lt;br/&gt;AUDIT_LOGS\&quot;] {\n        uuid id PK\n        timestamptz changed_at\n        uuid user_id FK\n        varchar entity_type \&quot;Полиморфная ссылка (без FK)\&quot;\n        uuid entity_id \&quot;UUID сущности\&quot;\n        jsonb changed_fields \&quot;Формат: { field: { old, new } }\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="oKXb5HMhzI_5EncT99IB-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
