# База данных PostgreSQL в Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=areal_hr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Порт бэкенда NestJS
PORT=3000
API_PORT=3000

# CORS
CORS_ORIGIN=http://localhost:9000,http://localhost:8080

# URL для миграций node-pg-migrate
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/areal_hr_db